# Copy this file to config.yaml, fill in the placeholders, then run
# ./deploy.sh --check to validate it. config.yaml holds credentials.

# uncomment to enable components
components:
        - frigate
        - ddns          # must-have for static outside access
        - caddy
        - pihole
        - beszel
        - landing       # index page at the apex domain, links every published subdomain
        - wg-easy
        - ssh
        - firewall
        - fileserver    # SMB mounting + web UI with expiring share/upload links

##################################################################
general:
        apex_domain: "example.com"        # your domain
        hostname: "myhost"                # this host's name
        fileserver_root: /srv/share

        build_path: ./build               # required - where --generate writes rendered configs
        install: /stacks/example          # required - where everything non-shared will exist on the target host
        host_ip: 10.13.13.1               # required by pihole - the IP peers should use to reach this host (typically its WireGuard address)
        wan_host: "myhost.duckdns.org"    # required by wg-easy - public hostname WG clients connect to (your ddns.domain, entered by hand - components can't reference each other)

        # optional - one folder of symlinks to every component's "main" config
        # file, for convenient inspection/editing. Only set up during
        # --deploy (the targets don't exist yet under --generate). Not every
        # component has one - see each component's config_file declaration
        # (currently: caddy, frigate, pihole, beszel, wg-easy, firewall).
        common_config_folder:
                enable: true
                path: /stacks/cfg

##################################################################
# installed via the official apt repo (lib/sh/caddy.sh), not docker.
# TLS is off for now - only WireGuard reaches this host, and pihole resolves
# *.example.com to it.
# reverse-proxy site blocks are generated automatically for every
# component that declares an http_route capability (e.g. frigate) - not
# user-configurable here.
caddy:
        https: true                        # true: TLS with caddy's local CA for every site (plus Let's Encrypt
                                           # for http_route.public addresses, which require it)
        wan_enable: true                   # opens 443/tcp on the WAN - required by fileserver.sftpgo.share_link;
                                           # forward 443 on the router too
        fileserver:                        # read-only view of general.fileserver_root, wg0-only
                enable: true
                subdomain: fs              # required - reachable at fs.<general.apex_domain>, same as any other subdomain
                browsable: true            # directory listing on/off
                # root is general.fileserver_root, not set here

##################################################################
# Everything that serves general.fileserver_root beyond caddy's read-only
# view: SMB mounting (samba) and a web UI with share/upload links (sftpgo).
# Each subcomponent has its own enable - one can be turned off without the
# other. Both write files as `user`, so whatever one creates stays
# readable/writable by the other.
fileserver:
        user: fileshare              # required - system account (no shell, no login) that owns everything
                                     # under general.fileserver_root; created on deploy

        # installed via apt, not docker. One SMB3 share of general.fileserver_root,
        # reachable only over WireGuard (the firewall only trusts wg0; no NetBIOS /
        # network discovery). Mount it as:
        #   Windows:        \\<general.host_ip>\<share_name>  (Map network drive)
        #   Linux/Android:  smb://<general.host_ip>/<share_name>
        samba:
                enable: true
                share_name: share    # required - the name you mount
                login: "me"          # required - SMB login; created as a no-login Linux user (no shell, no SSH)
                password: ""         # required - SMB password; separate from every other password here

        # docker (drakkan/sftpgo, version pinned in its compose.yaml). Web UI for
        # general.fileserver_root (browse, upload, download) plus expiring share and
        # upload links. Its own SFTP and WebDAV servers are off - samba handles
        # mounting, ssh handles SFTP.
        #
        # One address for everything: <share_link.subdomain>.<general.wan_host>.
        #   over WireGuard   the full web UI (admin at /web/admin, your login at
        #                    /web/client) - pihole resolves the name to host_ip
        #   from the WAN     share-link pages only, everything else 404s. Needs
        #                    caddy.wan_enable + caddy.https + 443 forwarded on the
        #                    router; gets a Let's Encrypt certificate (while that
        #                    fails, caddy's local CA instead - the tunnel side keeps
        #                    working, WAN visitors see a certificate warning)
        # Create links from that address - sftpgo builds each link from the
        # address you opened it at. <subdomain.name>.<general.apex_domain> (listed
        # on the landing page) just redirects there.
        #
        # The admin, user and outbox accounts below are created on the very first
        # start only, if missing - like wg-easy's INIT_* values, later changes here
        # have no effect; manage them in the web UI after that. Accounts and links
        # live in sftpgo's own database (persistent runtime state, never regenerated).
        sftpgo:
                enable: true
                subdomain:
                        name: sftpgo          # required - landing-page entry; redirects to the share_link address
                        port: 8080           # required - port sftpgo listens on, 127.0.0.1 only (caddy proxies to it)
                share_link:
                        subdomain: share     # required - links are served at share.<general.wan_host>
                admin_user: "admin"          # required - admin UI login (manages accounts, not files)
                admin_pass: ""               # required - USER, BE RESPONSIBLE
                user:                        # your everyday login: all of general.fileserver_root, cannot create links
                        name: "me"
                        password: ""
                outbox:                      # the only account that can create links - it sees nothing outside its
                                             # folder, so no link (or bug in link handling) can reach the rest
                        name: "outbox"
                        password: ""
                        folder: outbox       # required - under general.fileserver_root; created on deploy. Put files
                                             # here to share them; upload links must point at a folder in here too
                        quota: 20G           # total size the outbox may grow to (caps what uploaders fill); 0 = unlimited
                        max_file_size: 4G    # largest single uploaded file; 0 = unlimited

##################################################################
# docker (henrygd/beszel). Hub + agent for this host: CPU/RAM/disk/network
# history, per-container stats, and alerts. The hub's port is published on
# 127.0.0.1 only - the reverse proxy reaches it there, and a published docker
# port would otherwise bypass the host's INPUT policy onto the LAN.
# beszel_data/ (hub, includes its own SQLite db + generated SSH key) and
# agent_data/ (fingerprint) are persistent runtime state - never regenerated.
beszel:
        subdomain:
                name: monitor                 # required - reverse-proxy subdomain
                port: 8090                     # required - host-side port for the hub's web UI
                wan: false
        admin_email: "admin@example.com"  # required - initial hub login; any address, no mail is sent to it
        admin_pass: ""                     # required - min 10 chars, or the hub skips creating the user

        # One-time pairing. The hub generates its public key and registration
        # token on first run, so these cannot be known before it starts:
        # leave them empty for the first deploy (only the hub is rendered),
        # then follow the reminder printed at the end of that run.
        agent:
                key: ""
                token: ""
                # listen_port: 45876        # optional - agent's own loopback listener

##################################################################
# generated static index page served at the apex domain itself, linking every
# subdomain any component publishes (an http_route or static_site capability).
# Nothing to configure per-service - the list is derived from the registry.
landing:
        title: "myhost"                   # heading shown on the page; defaults to general.apex_domain
        wan: false                        # keep false - it enumerates your internal services

##################################################################
frigate:
        subdomain:
                name: "cams"               # required - reverse-proxy subdomain
                port: 8971                 # required - Frigate's web UI port
        docker:
                shm_size: "100m"           # required - shared memory for ffmpeg decoding, raise per camera resolution/count
                volumes:
                        - ./config:/config
                        - ./storage:/media/frigate
                ports:
                        - "8971:8971"
                        # - "5000:5000" # Internal unauthenticated access. Expose carefully.
                        # - "8554:8554" # RTSP feeds
                        - "8555:8555/tcp" # WebRTC over tcp
                        # - "8555:8555/udp" # WebRTC over udp

        # one entry per camera. Each cam is added to go2rtc as a "stream1" rtsp
        # stream using that cam's login/password/ip, and its ffmpeg input gets
        # the audio + record roles. Every cam is enabled; detect defaults
        # false if omitted.
        # onvif_port is optional - omit to skip onvif for that camera.
        cams:
               front_door:                 # required - name shown in Frigate/go2rtc, must be unique
                       login: ""            # required - camera RTSP/ONVIF username
                       password: ""         # required - camera RTSP/ONVIF password
                       ip: 0.0.0.0          # required - camera IP
                       stream: "stream1"    # camera's RTSP stream path
                       detect: false
                       onvif_port: 8000

##################################################################
# runs github.com/Nolven/duckdns_keepup as a systemd service (vendored
# read-only under components/ddns/)
ddns:
        bin_path: /usr/local/bin          # required - absolute path; the systemd unit's ExecStart is generated from this
        domain: ""                        # required - your duckdns subdomain
        token: ""                         # required - your duckdns token

##################################################################
# docker (pihole/pihole). DHCP is off - DNS/ad-blocking only. Frees host
# port 53 by disabling systemd-resolved's stub listener (lib/sh/pihole.sh) -
# the host's own resolver is left alone, only other WireGuard clients
# querying pihole get *.example.com resolution (general.host_ip).
# gravity/blocklists/whitelist are runtime state in the persisted
# /etc/pihole volume - never touched by --generate.
pihole:
        subdomain:
                name: "pihole"             # required - reverse-proxy subdomain
                port: 8081                 # required - Pi-hole web UI port
                redir: /admin              # optional - bare "/" redirects here (Pi-hole's UI lives under /admin)
        admin_pass: ""                     # required
        upstream_dns: "1.1.1.1"            # required - single value or a list; Pi-hole has no default, empty means it resolves nothing

##################################################################
# docker (ghcr.io/wg-easy/wg-easy). WireGuard server + webui, network_mode:
# host so wg0 lands on the host itself (general.host_ip). Peers are added
# through the webui, not config.yaml.
#
# v15's INIT_* setup only runs on the container's very first start - after
# that, listen_port/admin_user/admin_pass/dns changes here have no effect
# until also changed by hand in the webui at <subdomain.name>.<apex_domain>.
wg-easy:
        server_mask: 24                    # required
        listen_port: 44444                 # required - forward this UDP port from your router; outside this tool's scope
                                            # also declares a firewall_rule (udp/listen_port) so the firewall
                                            # component opens it on the WAN - that's how the tunnel gets reached
                                            # in the first place
        admin_user: "admin"                # required - webui login
        admin_pass: "changeme-please"      # required - USER, BE RESPONSIBLE - CHANGE
        subdomain:
                name: wg                   # required - reverse-proxy subdomain
                port: 51821                # required - webui's own listen port
                wan: false
        # dns: "1.1.1.1"                   # optional - default DNS pushed to WG clients (string or list);
                                            # unset, every dns_resolver in the registry is used (e.g. pihole
                                            # at general.host_ip), else wg-easy's own 1.1.1.1 default
        # device: eno1                     # optional - LAN interface peers' traffic is masqueraded out of;
                                            # unset, auto-detected from the host's default route. Unlike the
                                            # INIT_* values above, this one is enforced on every deploy

##################################################################
# writes a drop-in at /etc/ssh/sshd_config.d/99-serv.conf (Debian's default
# sshd_config Includes that directory first, so this overrides the stock
# settings below it without touching sshd_config itself). Validated with
# `sshd -t` before ever restarting ssh - reverts and refuses to restart if
# the new config is invalid, so a bad value here can't lock you out.
# Declares a firewall_rule like wg-easy does, so the firewall component
# opens this port on the WAN too - nothing hardcoded between the two.
ssh:
        port: 22                          # required - change together with the firewall in the same deploy
        permit_root_login: "no"           # yes | no | prohibit-password | forced-commands-only
        password_authentication: false    # keep false unless you haven't set up a key yet

##################################################################
# installed via the apt package (lib/sh/firewall.sh), not docker. nftables
# INPUT policy is drop; the wg0 interface is trusted entirely (nothing
# reachable only over the tunnel - frigate, caddy, pihole - needs its own
# rule). The only ports opened on the WAN are whatever components declare a
# firewall_rule capability (currently: wg-easy's listen_port, ssh's port -
# both handled identically, nothing ssh-specific hardcoded here).
# Re-running --generate/--deploy re-renders the whole ruleset from the
# current registry every time - it isn't hand-edited like wg0.conf.
firewall:
        nft_file_path: /etc/nftables.conf # required - where the generated ruleset is installed. If not
                                           # the default nftables.service path, a systemd override is added so
                                           # the service still loads it.
